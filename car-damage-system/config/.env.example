# ── Inference service (Phase 2) ──────────────────────────────────────────────
PREDICTOR_MODE=dummy               # "dummy" or "detectron2"
MODEL_WEIGHTS_PATH=models/car_damage_model.pth
INFERENCE_SCORE_THRESHOLD=0.45
DUMMY_INFERENCE_LATENCY_MS=80
MAX_DETECTIONS=20
CROP_PADDING_PX=30
INFERENCE_DEVICE=cpu

# LPR
LPR_LANGUAGES=en

# Inference server
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8001

# Camera
CAMERAS_CONFIG_PATH=config/cameras.yaml
FRAME_DIFF_THRESHOLD=8.0
FRAME_QUEUE_MAXSIZE=50
RECONNECT_INTERVAL_SECONDS=5

# ── Backend API (Phase 3) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/car_damage
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Buckets (auto-created on startup)
BUCKET_FULL_IMAGES=car-damage-full-images
BUCKET_CROPS=car-damage-crops
BUCKET_THUMBNAILS=car-damage-thumbnails

# Security
WEBHOOK_SECRET=changeme-use-a-real-secret

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=50
