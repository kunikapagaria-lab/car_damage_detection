[Unit]
Description=Car Damage Detection — Backend API (port 8000)
Documentation=https://github.com/your-org/car-damage-system
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service
PartOf=car-damage.target

[Service]
Type=exec
User=car-damage
Group=car-damage
WorkingDirectory=/opt/car-damage-system

# Load all secrets from a locked-down env file
EnvironmentFile=/opt/car-damage-system/.env

ExecStartPre=/opt/car-damage-system/venv/bin/alembic upgrade head
ExecStart=/opt/car-damage-system/venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 4 \
    --log-config /dev/null \
    --access-log

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/car-damage-system/logs /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=car-damage-backend

[Install]
WantedBy=multi-user.target
